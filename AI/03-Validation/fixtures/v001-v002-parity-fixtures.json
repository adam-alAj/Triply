{
  "version": "1.0.0",
  "description": "Shared V-001 (0%-invented-place) and V-002 (budget feasibility) fixtures consumed by BOTH the Python validation harness (AI/03-Validation/validate_shared_fixtures.py) and the C# validator parity test (Backend/Triply.Api.Tests/ValidationParityFixtureTests.cs). Every destination/place name is globally unique so the whole file can be seeded into one database. All trips are 2 days (2026-10-01..2026-10-02) so day-count/date rules match in both implementations.",
  "categories": ["ATTRACTION", "RESTAURANT", "ACTIVITY", "ACCOMMODATION", "TRANSPORT"],
  "tripStartDate": "2026-10-01",
  "tripEndDate": "2026-10-02",
  "expectedFieldNotes": "expected.v001Passed means 'the option is valid' — it covers Step 1 structural consistency AND the V-001 grounding rules. The C# runner asserts ItineraryValidationResult.IsValid; the Python runner asserts the equivalent OptionValidationResult.passed. expected.v002Passed covers the budget outcome (skipped, and therefore true, when V-001 already failed).",
  "expectedFailureNotes": "Per-case failure REASON checks, so a case expecting failure must fail for the right reason rather than for any reason. Matching is containment, not equality: every listed entry must be present, extra observed entries are allowed. `codes` are the Python harness failure codes (a subset of the observed codes must match); `fragments` are case-insensitive substrings of the C# validator's error text. PARITY-08 carries no C# fragment because V-002 lives in the orchestration service, not in ItineraryValidationService.",
  "expectedFailureChecks": {
    "PARITY-02": { "codes": ["PLACE_NOT_FOUND"], "fragments": ["does not exist or is inactive"] },
    "PARITY-03": { "codes": ["DESTINATION_NOT_FOUND"], "fragments": ["does not exist in the supported destination dataset"] },
    "PARITY-04": { "codes": ["PLACE_WRONG_DESTINATION"], "fragments": ["belongs to destination_id"] },
    "PARITY-05": { "codes": ["ACCOMMODATION_IN_DAYS"], "fragments": ["must be in accommodation only"] },
    "PARITY-06": { "codes": ["MISSING_RESTAURANT"], "fragments": ["no RESTAURANT-category place found"] },
    "PARITY-07": { "codes": ["PLACE_NOT_FOUND"], "fragments": ["does not exist or is inactive"] },
    "PARITY-08": { "codes": ["ALL_OPTIONS_OVER_BUDGET"], "fragments": [] },
    "PARITY-10": { "codes": ["STRUCTURE_INVALID"], "fragments": ["must be contiguous starting at 1"] },
    "PARITY-11": { "codes": ["STRUCTURE_INVALID"], "fragments": ["trip duration"] },
    "PARITY-12": { "codes": ["STRUCTURE_INVALID"], "fragments": ["duplicate (time_slot="] }
  },
  "cases": [
    {
      "id": "PARITY-01",
      "name": "Valid grounded destination-first plan passes V-001",
      "planningMode": "DESTINATION_FIRST",
      "destination": "PARITY01 Paris",
      "budget": null,
      "dataset": {
        "destinations": [{ "name": "PARITY01 Paris", "isSupported": true }],
        "places": [
          { "name": "PARITY01 Hotel", "destination": "PARITY01 Paris", "category": "ACCOMMODATION", "isActive": true, "referencePrice": 100.0, "currency": "USD" },
          { "name": "PARITY01 Restaurant", "destination": "PARITY01 Paris", "category": "RESTAURANT", "isActive": true, "referencePrice": 20.0, "currency": "USD" },
          { "name": "PARITY01 Transport", "destination": "PARITY01 Paris", "category": "TRANSPORT", "isActive": true, "referencePrice": 10.0, "currency": "USD" }
        ]
      },
      "itinerary": {
        "planning_mode": "DESTINATION_FIRST",
        "destination_options": [
          {
            "destination_name": "PARITY01 Paris",
            "accommodation": { "place_name": "PARITY01 Hotel", "nights": 2 },
            "days": [
              { "day_number": 1, "date": "2026-10-01", "items": [
                { "time_slot": "MORNING", "order_index": 1, "place_name": "PARITY01 Restaurant" },
                { "time_slot": "AFTERNOON", "order_index": 1, "place_name": "PARITY01 Transport" }
              ] },
              { "day_number": 2, "date": "2026-10-02", "items": [
                { "time_slot": "EVENING", "order_index": 1, "place_name": "PARITY01 Restaurant" }
              ] }
            ]
          }
        ]
      },
      "expected": { "v001Passed": true, "v002Passed": true }
    },
