# Triply Backend - Environment Configuration Example
# Copy to .env locally and replace all placeholder values.
# NEVER commit .env or real secrets.

ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__Default=Server=(localdb)\mssqllocaldb;Database=TriplyDb;Trusted_Connection=True;MultipleActiveResultSets=true

Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET
Jwt__Issuer=Triply
Jwt__Audience=TriplyClients
Jwt__ExpiresMinutes=60

Gemini__ApiKey=REPLACE_WITH_GEMINI_API_KEY

Cors__AllowedOrigins=http://localhost:5173
